# Preferred TMDb v4 API Read Access Token
TMDB_BEARER_TOKEN=PASTE_YOUR_TMDB_API_READ_ACCESS_TOKEN_HERE

# Alternative legacy TMDb v3 API key, supported for compatibility
# TMDB_API_KEY=PASTE_YOUR_LEGACY_TMDB_V3_API_KEY_HERE

PORT=5050
# Used until an address/port is saved in Settings > Network.
HOST=127.0.0.1
# Emergency, session-only overrides: TVMANAGER_BIND_HOST / TVMANAGER_BIND_PORT.
# LAN listeners require configured browser login; see Settings > Security.

# Trakt.tv discovery integration
# Create a Trakt API app and paste the client id here. Public discovery does not require OAuth.
TRAKT_CLIENT_ID=PASTE_YOUR_TRAKT_CLIENT_ID_HERE
# Optional: authenticated user/library sync later
# TRAKT_ACCESS_TOKEN=PASTE_OPTIONAL_TRAKT_ACCESS_TOKEN_HERE
